# Настройки docker-окружения (не путать с backend/.env — тот отдельный).
# Скопировать в .env: cp .env.example .env

DB_DATABASE=litoreya
DB_USERNAME=litoreya
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root
DB_PORT=3307

API_PORT=8080
WEB_PORT=3000
PRODLIKE_PORT=8081

# UID/GID хоста — чтобы файлы, созданные в контейнере, не оказались root-овыми
UID=1000
GID=1000

# --- деплой на хостинг (bin/deploy.sh) ---
# Заполнить своими значениями. Заполненный .env в репозиторий не попадает.

# Пользователь и хост для ssh/rsync, в формате пользователь@хост
DEPLOY_HOST=localhost
# Каталог приложения относительно домашнего каталога на сервере
DEPLOY_PATH=litoreya
# Базовый адрес сайта — по нему прогоняется дым-тест после переключения
DEPLOY_URL=
# Полный путь к бинарю PHP, под которым работает веб-сервер. `php` из PATH на
# shared хостинге часто оказывается другой версии. Нужен 8.2+: Laravel 12 на 8.1
# не запускается. Типичное расположение — /opt/php/8.2/bin/php.
DEPLOY_PHP=
