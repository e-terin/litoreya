# Настройки docker-окружения (не путать с backend/.env — тот отдельный).
# Скопировать в .env: cp .env.example .env

DB_DATABASE=litoreya
DB_USERNAME=litoreya
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

DB_PORT=3307
API_PORT=8080
WEB_PORT=3000
PRODLIKE_PORT=8081

# UID/GID хоста — чтобы файлы, созданные в контейнере, не оказались root-овыми
UID=1000
GID=1000
