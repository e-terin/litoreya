# Шаблон прод-окружения. Копируется в ~/litoreya/shared/.env на хостинге
# и заполняется вручную. В репозиторий заполненный файл не попадает никогда.
#
# APP_KEY генерируется НА СЕРВЕРЕ (php artisan key:generate). Локальный ключ
# переносить нельзя: это подпись сессионных кук.

APP_NAME=Litoreya
APP_ENV=production
APP_KEY=
# При APP_DEBUG=true любое исключение отдаёт стек и дамп окружения — то есть
# APP_KEY и пароль БД прямо в HTTP-ответе.
APP_DEBUG=false
# Базовый адрес сайта, со схемой: https://example.com
APP_URL=

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en

# --- база данных (доступы из панели хостинга) ---
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --- сессия и Sanctum ---
# Домены через запятую, без схемы. Вариант с www стоит перечислить, даже если
# настроен редирект: он отработает раньше Laravel, но стоимость строки нулевая,
# а отладка «на www не логинится» — нет.
SANCTUM_STATEFUL_DOMAINS=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_PATH=/
# Оставить пустым. Домен с точкой в начале отдал бы куку всем поддоменам,
# включая будущий стейджинг.
SESSION_DOMAIN=
# Сейчас в config/session.php это env без дефолта, то есть null = кука не Secure.
# Обратная сторона: по http вход будет молча не работать — куки просто не будет.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# --- драйверы ---
# file, а не database: единственный горячий потребитель кеша — rate limiter на
# /api/auth/*, лишние коннекты к MySQL там не нужны.
CACHE_STORE=file
# sync, а не database: воркера на shared хостинге нет, и при database любой
# dispatch() тихо лёг бы в таблицу навсегда. С sync ошибка проявится сразу.
QUEUE_CONNECTION=sync

# --- логи ---
# daily, а не single: один файл растёт вечно, а на shared хостинге исчерпание
# квоты выглядит как что угодно, кроме диска.
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

MAIL_MAILER=log
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
