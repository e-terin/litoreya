# Front controller Laravel. REQUEST_URI сохраняется при перезаписи,
# поэтому маршрут /api/health в routes/api.php совпадает как есть.

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Заголовок Authorization не всегда доходит до PHP при mod_php/CGI
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
