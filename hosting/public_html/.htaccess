# Корень веб-сервера. Здесь лежит статический экспорт Next.js.
# Запросы к /api/* перехватывает api/.htaccess и отдаёт Laravel.

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On
    RewriteBase /

    # /api/* обслуживается своим .htaccess — здесь не трогаем
    RewriteRule ^api(/|$) - [L]

    # Существующие файлы и каталоги отдаём как есть
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Всё остальное — в SPA. Роутинг клиентский, глубокие ссылки должны работать.
    RewriteRule ^ index.html [L]
</IfModule>

# Ассеты Next.js содержат хеш в имени — кешируются навсегда
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|woff2?|png|svg|webp|avif)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # HTML не кешируем: он ссылается на конкретные хеши ассетов
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    # Именно same-origin, не no-referrer: Sanctum в cookie-режиме опознаёт "свой"
    # запрос по Referer/Origin, а для same-origin GET браузер Origin не отправляет.
    # no-referrer убрал бы и Referer — сессия перестала бы применяться на всех GET.
    Header always set Referrer-Policy "same-origin"
</IfModule>

# Точечные файлы (.env, .git, ...) не должны быть доступны никогда
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
